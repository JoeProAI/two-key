# mock = hand-written fixtures, no network, no keys. live = Airwallex sandbox.
AIRWALLEX_MODE=mock
# Sandbox only. Set as Runtime Secrets, never commit, never prefix with NEXT_PUBLIC_.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Secret for the notification URL (per webhook subscription).
AIRWALLEX_WEBHOOK_SECRET=
# Optional, only if the scoped key covers several accounts (x-login-as header).
AIRWALLEX_LOGIN_AS=
# Agents. All model calls go through OpenRouter. AGENT_MODE=stub uses deterministic stubs.
AGENT_MODE=stub
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PLANNER=
OPENROUTER_MODEL_WRINGER=
# Money moves at or above this USD-equivalent amount wait for a human tap.
APPROVAL_THRESHOLD_USD=10000
# Convex (npx convex dev writes NEXT_PUBLIC_CONVEX_URL). The webhook route uses CONVEX_URL, falling back to it.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=
# Shared secret for the public ledger:ingestWebhook mutation. Set the same value in the Convex deployment env
# and here, as a Runtime Secret. Unset = in-memory webhook store.
TWO_KEY_INGEST_SECRET=
